---
import Base from "../layouts/Base.astro";
import ProjectDeck from "../components/home/ProjectDeck.astro";
import { site } from "../data/site";
import { featuredWork, accentStyle } from "../lib/work";

const featured = await featuredWork();
---

<Base>
  <section class="hero container grid-12">
    <div class="hero__text">
      <h1 class="hero__title">
        I build systems that run in production, and I measure whether they work.
      </h1>
      <p class="hero__lead measure">
        I am a final-year computer science student in Bangalore. Most of what I know I
        learned by shipping things other people then had to rely on: AI agents in real
        customer conversations, serverless platforms holding real data, and one
        brain-computer interface that started as a sketch and now has electrodes.
      </p>
      <div class="hero__actions">
        <a class="button" href="/work">See the work</a>
        <a class="hero__secondary wipe" href={`mailto:${site.email}`}>Or email me</a>
      </div>
    </div>

    <div class="hero__figure">
      <ProjectDeck />
    </div>
  </section>

  <section class="work container">
    <div class="work__head">
      <h2 class="work__title">Selected work</h2>
      <p class="note work__intro measure">
        One piece of research, one product, one client engagement. Each has a number
        beside it that I can defend, and a page that shows where it came from.
      </p>
    </div>

    <ol class="ledger">
      {
        featured.map((e) => (
          <li class="ledger__row row-hover accent-scope" style={accentStyle(e.data)}>
            <a href={`/work/${e.id}`} class="ledger__link grid-12">
              <span class="ledger__bar" aria-hidden="true" />
              <span class="ledger__kind note">{e.data.context}</span>
              <h3 class="ledger__title">{e.data.title}</h3>
              <p class="ledger__line">{e.data.tagline}</p>
              {e.data.headline && (
                <p class="ledger__stat">
                  <span class="ledger__value data">
                    {e.data.headline.value}
                    {e.data.headline.unit && (
                      <span class="ledger__unit">{e.data.headline.unit}</span>
                    )}
                  </span>
                  <span class="ledger__label note">{e.data.headline.label}</span>
                </p>
              )}
            </a>
          </li>
        ))
      }
    </ol>

    <p class="work__all">
      <a class="wipe" href="/work">All ten projects</a>
    </p>
  </section>
</Base>

<style>
  /* ---------------------------------------------------------------- hero */
  .hero {
    padding-block: clamp(3.5rem, 2rem + 6vw, 7rem) clamp(2rem, 1rem + 4vw, 4rem);
    row-gap: 3rem;
    align-items: start;
  }

  .hero__text {
    grid-column: 1 / span 12;
  }

  .hero__figure {
    grid-column: 1 / span 12;
    margin: 0;
  }

  @media (min-width: 64rem) {
    .hero__text {
      grid-column: 1 / span 5;
      padding-top: 0.5rem;
    }
    .hero__figure {
      grid-column: 6 / span 7;
    }
  }

  .hero__title {
    font-size: var(--step-5);
    max-width: 20ch;
  }

  .hero__lead {
    margin-top: 1.75rem;
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--ink-muted);
  }

  .hero__actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-top: 2.25rem;
  }

  .hero__secondary {
    color: var(--ink-muted);
  }

  .hero__secondary:hover {
    color: var(--ink);
  }

  /* ---------------------------------------------------------------- work */
  .work {
    padding-top: var(--space-section);
  }

  .work__head {
    display: grid;
    gap: 0.75rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--ink);
  }

  .work__title {
    font-size: var(--step-3);
  }

  .work__intro {
    max-width: 58ch;
  }

  .ledger {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .ledger__row {
    border-bottom: 1px solid var(--line);
  }

  .ledger__link {
    position: relative;
    text-decoration: none;
    padding: 1.6rem 0 1.6rem 1.25rem;
    row-gap: 0.5rem;
    align-items: baseline;
  }

  /* The project colour, as a rule in the margin — not a wash, not a badge. */
  .ledger__bar {
    position: absolute;
    left: 0;
    top: 1.6rem;
    bottom: 1.6rem;
    width: 3px;
    background: var(--accent);
  }

  .ledger__kind {
    grid-column: 1 / span 12;
  }

  .ledger__title {
    grid-column: 1 / span 12;
    font-size: var(--step-3);
  }

  .ledger__line {
    grid-column: 1 / span 12;
    color: var(--ink-muted);
    max-width: 56ch;
  }

  .ledger__stat {
    grid-column: 1 / span 12;
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    margin-top: 0.4rem;
  }

  .ledger__value {
    font-size: var(--step-2);
    color: var(--accent-ink);
  }

  .ledger__unit {
    font-size: var(--step-0);
    margin-left: 0.2em;
  }

  @media (min-width: 52rem) {
    .ledger__link {
      row-gap: 0.35rem;
      padding-block: 1.9rem;
    }
    .ledger__kind {
      grid-column: 1 / span 2;
    }
    .ledger__title {
      grid-column: 3 / span 4;
    }
    .ledger__line {
      grid-column: 7 / span 3;
      grid-row: 1 / span 2;
    }
    .ledger__stat {
      grid-column: 10 / span 3;
      grid-row: 1 / span 2;
      flex-direction: column;
      align-items: flex-end;
      text-align: right;
      gap: 0.15rem;
      margin-top: 0;
    }
  }

  .work__all {
    margin-top: 1.75rem;
  }

  .work__all a {
    font-weight: 500;
  }
</style>
