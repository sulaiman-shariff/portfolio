---
/**
 * Project deck — the home hero.
 *
 * Six real project screens held as panes of glass in a shallow perspective
 * stack, each edge-lit in its own accent. Back panes are tinted: the screenshot
 * is blended in luminosity over an accent field, so wildly different products
 * read as one instrument rack. Bringing a pane to the front resolves it back to
 * full colour, and the front pane of the video engine plays the real generated
 * animation rather than a still.
 *
 * The tint is doing honest work. These are six unrelated interfaces at six
 * different aspect ratios; without it the hero is a pile of screenshots.
 *
 * Motion answers the pointer and answers a click. Nothing advances on its own.
 * Under prefers-reduced-motion the rig is static, the video stays a poster, and
 * the panes are still selectable.
 */
import { Image } from "astro:assets";
import { getEntry } from "astro:content";
import { heroVideos } from "../../data/hero-videos";

interface DeckItem {
  slug: string;
  /** Overrides the tagline in the readout — the video engine shows its prompt. */
  line?: string;
  /** Label above the readout line. */
  lineKind?: string;
  video?: string;
}

const items: DeckItem[] = [
  {
    slug: "video-engine",
    line: heroVideos[0]!.prompt,
    lineKind: "Prompt",
    video: heroVideos[0]!.src,
  },
  { slug: "aura" },
  { slug: "edactly" },
  { slug: "linkubit" },
  { slug: "scraper" },
  { slug: "murder-mystery" },
];

const panes = await Promise.all(
  items.map(async (item) => {
    const entry = await getEntry("work", item.slug);
    if (!entry?.data.hero) throw new Error(`deck: ${item.slug} has no hero image`);
    return { ...item, entry, data: entry.data, hero: entry.data.hero };
  }),
);

const first = panes[0]!;
const statOf = (p: (typeof panes)[number]) =>
  p.data.headline ? `${p.data.headline.value}${p.data.headline.unit ?? ""}` : "";
const labelOf = (p: (typeof panes)[number]) => p.data.headline?.label ?? p.data.context;
---

<div class="deck accent-scope" data-deck>
  <div class="deck__stage" data-stage>
    {
      panes.map((p, i) => (
        <article
          class="pane accent-scope"
          data-pane={p.slug}
          data-index={i}
          data-rel={i}
          data-title={p.data.title}
          data-line={p.line ?? p.data.tagline}
          data-linekind={p.lineKind ?? "What it is"}
          data-stat={statOf(p)}
          data-statlabel={labelOf(p)}
          data-href={`/work/${p.slug}`}
          style={`--accent-base: ${p.data.accent.base}`}
        >
          <a class="pane__hit" href={`/work/${p.slug}`}>
            <span class="u-visually-hidden">Open {p.data.title}</span>
          </a>

          <div class="pane__glass">
            <Image
              class="pane__shot"
              src={p.hero.src}
              alt=""
              widths={[480, 720, 960]}
              sizes="(min-width: 64rem) 34rem, 80vw"
              loading={i === 0 ? "eager" : "lazy"}
            />
            {p.video && (
              <video
                class="pane__video"
                muted
                loop
                playsinline
                preload="none"
                aria-label={`Animation generated from the prompt: ${p.line}`}
              >
                <source src={p.video} type="video/mp4" />
              </video>
            )}
            <span class="pane__grid" aria-hidden="true" />
            <span class="pane__scan" aria-hidden="true" />
            <span class="pane__sheen" aria-hidden="true" />
            <span class="pane__sweep" aria-hidden="true" />

            <p class="pane__plate">
              <span class="pane__name">{p.data.title}</span>
              {statOf(p) && <span class="pane__stat data">{statOf(p)}</span>}
            </p>
          </div>
        </article>
      ))
    }
  </div>

  <div class="deck__readout">
    <p class="deck__kind note" data-kind>{first.lineKind ?? "What it is"}</p>
    <p class="deck__line" data-line>{first.line ?? first.data.tagline}</p>
    <p class="deck__foot">
      {
        statOf(first) && (
          <span class="deck__stat">
            <span class="data" data-stat>
              {statOf(first)}
            </span>
            <span class="note" data-statlabel>
              {labelOf(first)}
            </span>
          </span>
        )
      }
      <a class="deck__link wipe" href={`/work/${first.slug}`} data-link>
        Open <span data-linktitle>{first.data.title}</span>
      </a>
    </p>

    <div class="deck__rail" role="group" aria-label="Choose a project">
      {
        panes.map((p, i) => (
          <button
            class="deck__dot accent-scope"
            type="button"
            data-select={i}
            aria-pressed={i === 0 ? "true" : "false"}
            style={`--accent-base: ${p.data.accent.base}`}
          >
            <span class="u-visually-hidden">{p.data.title}</span>
          </button>
        ))
      }

      {/* Content that moves on its own needs a way to stop it. */}
      <button class="deck__hold" type="button" data-hold hidden>
        <svg viewBox="0 0 12 12" aria-hidden="true" width="10" height="10">
          <rect class="deck__holdpause" x="2" y="1.5" width="3" height="9" />
          <rect class="deck__holdpause" x="7" y="1.5" width="3" height="9" />
          <path class="deck__holdplay" d="M3 1.5v9l7-4.5z" />
        </svg>
        <span data-holdlabel>Pause</span>
      </button>
    </div>
  </div>
</div>

<style>
  .deck {
    display: grid;
    gap: 1.5rem;
    --dwell: 2s;
  }

  /* --------------------------------------------------------------- stage */
  .deck__stage {
    position: relative;
    aspect-ratio: 16 / 11;
    perspective: 1500px;
    perspective-origin: 30% 45%;
    transform-style: preserve-3d;
    /* Pointer position, -1..1, written by the script. */
    --px: 0;
    --py: 0;
  }

  @media (min-width: 64rem) {
    .deck__stage {
      aspect-ratio: 16 / 9;
    }
  }

  /* --------------------------------------------------------------- panes */

  /* Slot geometry is written out per depth rather than derived from a formula.
     A linear ramp puts every pane behind the first one as a 60px sliver; what
     the hero needs is four projects legible at once, which means the offsets
     have to open up fast and then close. */
  .pane {
    position: absolute;
    left: 0;
    top: 0;
    width: 62%;
    margin: 0;
    transform-style: preserve-3d;
    --x: 0%;
    --y: 16%;
    --z: 0px;
    --ry: 0deg;
    --depth: 0;

    transform: translate3d(
        calc(var(--x) + var(--px) * var(--depth) * -13px),
        calc(var(--y) + var(--py) * var(--depth) * -9px),
        var(--z)
      )
      rotateY(calc(var(--ry) + var(--px) * 8deg))
      rotateX(calc(var(--py) * -5deg));

    z-index: calc(20 - var(--depth));
    transition:
      transform 560ms cubic-bezier(0.62, 0.05, 0.2, 1),
      opacity 520ms ease;
  }

  .pane[data-rel="0"] { --x: 0%; --y: 13%; --z: 0px; --ry: 0deg; --depth: 0; }
  .pane[data-rel="1"] { --x: 46%; --y: 6%; --z: -150px; --ry: -9deg; --depth: 1; opacity: 0.94; }
  .pane[data-rel="2"] { --x: 84%; --y: 0%; --z: -290px; --ry: -13deg; --depth: 2; opacity: 0.8; }
  .pane[data-rel="3"] { --x: 118%; --y: -5%; --z: -410px; --ry: -16deg; --depth: 3; opacity: 0.6; }

  /* Anything deeper parks off the back of the rack. It is still focusable
     through the rail below, it just has nowhere legible to sit. */
  .pane[data-rel="4"],
  .pane[data-rel="5"],
  .pane[data-rel="6"],
  .pane[data-rel="7"],
  .pane[data-rel="8"],
  .pane[data-rel="9"] {
    --x: 136%;
    --y: -9%;
    --z: -500px;
    --ry: -18deg;
    --depth: 4;
    opacity: 0;
    pointer-events: none;
  }

  /* The glass itself. Dark on purpose: the screenshots are six different
     products, and a common ground is what lets them read as one rack. */
  .pane__glass {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 10px;
    /* The accent field the screenshot is blended against. This must be the
       glass's own background rather than a child: a luminosity blend mixes
       with whatever is painted below it in the same stacking context, and a
       separate layer behind the background never reaches the image. */
    background: linear-gradient(
      152deg,
      color-mix(in oklab, var(--accent) 88%, white) 0%,
      var(--accent) 46%,
      color-mix(in oklab, var(--accent) 62%, #06080c) 100%
    );
    box-shadow:
      0 0 0 1px color-mix(in oklab, var(--accent) 55%, transparent),
      0 0 22px -4px color-mix(in oklab, var(--accent) 55%, transparent),
      0 34px 60px -28px rgb(0 0 0 / 0.55);
  }

  .pane__glass :global(img),
  .pane__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  /* Tinted while it is behind: luminosity over an accent field turns a
     screenshot into a readout. The front pane resolves back to full colour. */
  .pane__glass :global(img) {
    mix-blend-mode: luminosity;
    opacity: 0.9;
    transition:
      opacity 420ms ease,
      filter 420ms ease;
    /* A luminosity blend keeps the backdrop's hue and takes the image's
       lightness, so a bright screenshot washes the accent out and a dark one
       swallows it. Compressing contrast pulls the whole image toward mid
       lightness, which is where the accent's chroma actually reads. */
    filter: grayscale(1) contrast(0.42) brightness(1.02);
  }

  .pane__video {
    opacity: 0;
    transition: opacity 420ms ease;
  }

  /* A graticule, not decoration: this is a bench instrument. */
  .pane__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgb(255 255 255 / 0.08) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(255 255 255 / 0.08) 1px, transparent 1px);
    background-size: 44px 44px;
    opacity: 0.65;
    transition: opacity 520ms ease;
  }

  .pane__scan {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      to bottom,
      rgb(0 0 0 / 0.22) 0 1px,
      transparent 1px 3px
    );
    opacity: 0.5;
    transition: opacity 520ms ease;
  }

  /* Specular highlight, tied to the pointer rather than to a timer. */
  .pane__sheen {
    position: absolute;
    inset: -40%;
    background: linear-gradient(
      104deg,
      transparent 38%,
      rgb(255 255 255 / 0.1) 48%,
      rgb(255 255 255 / 0.03) 56%,
      transparent 64%
    );
    transform: translateX(calc(var(--px) * 26%));
    mix-blend-mode: screen;
    pointer-events: none;
  }

  .pane__sweep {
    position: absolute;
    left: 0;
    right: 0;
    height: 28%;
    top: -30%;
    background: linear-gradient(
      to bottom,
      transparent,
      color-mix(in oklab, var(--accent) 40%, transparent),
      transparent
    );
    mix-blend-mode: screen;
    opacity: 0;
    pointer-events: none;
  }

  /* --------------------------------------------------- the front pane */
  .pane.is-front .pane__glass {
    box-shadow:
      0 0 0 1px color-mix(in oklab, var(--accent) 85%, transparent),
      0 0 34px -2px color-mix(in oklab, var(--accent) 65%, transparent),
      0 46px 80px -34px rgb(0 0 0 / 0.6);
  }

  .pane.is-front .pane__glass :global(img) {
    mix-blend-mode: normal;
    opacity: 1;
    filter: none;
  }

  .pane.is-front .pane__grid,
  .pane.is-front .pane__scan {
    opacity: 0.18;
  }

  .pane.is-playing .pane__video {
    opacity: 1;
  }

  .pane.is-front .pane__sweep {
    animation: sweep 5.5s cubic-bezier(0.6, 0, 0.4, 1) infinite;
  }

  @keyframes sweep {
    0%,
    62% {
      top: -30%;
      opacity: 0;
    }
    66% {
      opacity: 0.55;
    }
    100% {
      top: 104%;
      opacity: 0;
    }
  }

  /* --------------------------------------------------------------- plate */

  /* Inside the glass, so it travels with its own pane instead of colliding
     with the plate of the pane in front of it. */
  .pane__plate {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin: 0;
    padding: 1.4rem 0.85rem 0.6rem;
    background: linear-gradient(to top, rgb(4 6 8 / 0.9), rgb(4 6 8 / 0.45) 55%, transparent);
    color: #f2f1ee;
    z-index: 3;
  }

  .pane__name {
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.01em;
  }

  .pane__stat {
    font-size: var(--step--1);
    color: color-mix(in oklab, var(--accent) 55%, white);
  }

  /* --------------------------------------------------------------- hit */
  /* The whole pane is the link. A visitor who wants a project clicks the
     project, wherever it currently sits in the rack. */
  .pane__hit {
    position: absolute;
    inset: 0;
    z-index: 4;
    border-radius: 10px;
    text-decoration: none;
  }

  .pane__hit:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  /* Driven by the script, not by :hover — see the note in the script. */
  .deck__stage.is-over {
    cursor: pointer;
  }

  .pane__glass {
    transition:
      transform 320ms cubic-bezier(0.62, 0.05, 0.2, 1),
      box-shadow 320ms ease;
  }

  .pane.is-hot .pane__glass {
    transform: translateY(-5px);
    box-shadow:
      0 0 0 1px color-mix(in oklab, var(--accent) 92%, transparent),
      0 0 38px -2px color-mix(in oklab, var(--accent) 72%, transparent),
      0 40px 70px -30px rgb(0 0 0 / 0.6);
  }

  /* A pane you are pointing at stops pretending to be a hologram. */
  .pane.is-hot .pane__glass :global(img) {
    opacity: 1;
    filter: grayscale(0.35) contrast(1) brightness(1);
  }

  .pane.is-hot .pane__grid,
  .pane.is-hot .pane__scan {
    opacity: 0.2;
  }

  /* ------------------------------------------------------------ readout */
  .deck__readout {
    display: grid;
    gap: 0.55rem;
    max-width: 46ch;
  }

  .deck__line {
    font-size: var(--step-0);
    line-height: 1.5;
    text-wrap: pretty;
  }

  .deck__foot {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    margin-top: 0.2rem;
  }

  .deck__stat {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
  }

  .deck__stat .data {
    font-size: var(--step-1);
    color: var(--accent-ink);
  }

  .deck__link {
    font-weight: 500;
  }

  .deck__rail {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.35rem;
  }

  .deck__dot {
    position: relative;
    width: 2.25rem;
    /* The visible bar is drawn by ::before. The button itself is sized for a
       thumb: an 8px-tall control is not tappable. */
    height: 2.75rem;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .deck__dot::before,
  .deck__dot::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 0.28rem;
    margin-top: -0.14rem;
    border-radius: 99px;
    transition:
      background 260ms ease,
      height 200ms ease,
      margin-top 200ms ease;
  }

  .deck__dot::before {
    background: var(--line-strong);
  }

  .deck__dot:hover::before {
    background: var(--accent);
  }

  .deck__dot[aria-pressed="true"]::before {
    background: color-mix(in oklab, var(--accent) 26%, var(--line-strong));
    height: 0.45rem;
    margin-top: -0.225rem;
  }

  /* The fill that runs over the dwell, so the next switch is expected. */
  .deck__dot::after {
    background: var(--accent);
    transform-origin: left center;
    transform: scaleX(0);
  }

  .deck__dot[aria-pressed="true"]::after {
    transform: scaleX(1);
    height: 0.45rem;
    margin-top: -0.225rem;
  }

  .deck.is-auto .deck__dot[aria-pressed="true"]::after {
    animation: dwell var(--dwell, 2s) linear forwards;
  }

  .deck.is-held .deck__dot[aria-pressed="true"]::after {
    animation-play-state: paused;
  }

  @keyframes dwell {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  .deck__hold {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-left: 0.35rem;
    min-height: 2.75rem;
    padding: 0 0.5rem;
    border: 0;
    background: transparent;
    color: var(--ink-faint);
    font: inherit;
    font-size: var(--step--1);
    cursor: pointer;
    align-self: center;
  }

  .deck__hold:hover {
    color: var(--ink);
  }

  .deck__hold svg {
    fill: currentColor;
  }

  .deck__hold .deck__holdplay {
    display: none;
  }

  .deck.is-hold .deck__hold .deck__holdplay {
    display: block;
  }

  .deck.is-hold .deck__hold .deck__holdpause {
    display: none;
  }

  /* --------------------------------------------------------- responsive */
  /* On a phone only the front card and the edge of the next one can fit, so
     stop pretending otherwise and give the front card the room. */
  @media (max-width: 52rem) {
    .deck__stage {
      aspect-ratio: 4 / 3;
      perspective-origin: 50% 45%;
    }
    .pane {
      width: 96%;
    }
    .pane[data-rel="0"] {
      --y: 8%;
    }
    .pane__grid {
      background-size: 30px 30px;
    }
    .deck__readout {
      max-width: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pane {
      transition: none;
    }
    .pane.is-front .pane__sweep {
      animation: none;
    }
    .pane__sheen {
      transform: none;
    }
  }
</style>

<script>
  const deck = document.querySelector<HTMLElement>("[data-deck]");

  if (deck) {
    const root = deck;
    const stage = deck.querySelector<HTMLElement>("[data-stage]")!;
    const panes = Array.from(deck.querySelectorAll<HTMLElement>("[data-pane]"));
    const dots = Array.from(deck.querySelectorAll<HTMLButtonElement>(".deck__dot"));
    // Scoped to the readout on purpose: the panes carry data-line, data-stat and
    // data-statlabel too, and an unscoped query matches the first pane instead.
    const box = deck.querySelector<HTMLElement>(".deck__readout")!;
    const readout = {
      kind: box.querySelector<HTMLElement>("[data-kind]")!,
      line: box.querySelector<HTMLElement>("[data-line]")!,
      stat: box.querySelector<HTMLElement>("[data-stat]"),
      statLabel: box.querySelector<HTMLElement>("[data-statlabel]"),
      link: box.querySelector<HTMLAnchorElement>("[data-link]")!,
      linkTitle: box.querySelector<HTMLElement>("[data-linktitle]")!,
    };

    const calm = window.matchMedia("(prefers-reduced-motion: reduce)");
    const n = panes.length;
    let active = 0;
    let onScreen = true;

    panes.forEach((p) => {
      const v = p.querySelector("video");
      if (!v) return;
      p.classList.add("has-video");
      // The poster stays visible until there is a frame to replace it with.
      v.addEventListener("playing", () => p.classList.add("is-playing"));
      v.addEventListener("pause", () => p.classList.remove("is-playing"));
    });

    const video = (p: HTMLElement) => p.querySelector<HTMLVideoElement>("video");

    function playFront() {
      panes.forEach((p, i) => {
        const v = video(p);
        if (!v) return;
        if (i === active && onScreen && !calm.matches) {
          if (v.preload === "none") v.preload = "auto";
          v.play().catch(() => {});
        } else {
          v.pause();
        }
      });
    }

    function render() {
      panes.forEach((p, i) => {
        const rel = (i - active + n) % n;
        p.dataset.rel = String(rel);
        p.classList.toggle("is-front", rel === 0);
          // Panes parked off the back of the rack are invisible; keep them out
        // of the tab order rather than focusing something nobody can see.
        const hit = p.querySelector<HTMLAnchorElement>(".pane__hit")!;
        const parked = rel > 3;
        hit.tabIndex = parked ? -1 : 0;
        hit.setAttribute("aria-hidden", String(parked));
      });

      const p = panes[active]!;
      readout.kind.textContent = p.dataset.linekind ?? "";
      readout.line.textContent = p.dataset.line ?? "";
      if (readout.stat) readout.stat.textContent = p.dataset.stat ?? "";
      if (readout.statLabel) readout.statLabel.textContent = p.dataset.statlabel ?? "";
      readout.link.href = p.dataset.href ?? "#";
      readout.linkTitle.textContent = p.dataset.title ?? "";
      // The readout borrows the active project's colour.
      root.style.setProperty(
        "--accent-base",
        getComputedStyle(p).getPropertyValue("--accent-base"),
      );

      dots.forEach((d, i) => d.setAttribute("aria-pressed", String(i === active)));
      playFront();
    }

    function select(i: number) {
      active = ((i % n) + n) % n;
      render();
      restart();
    }

    // ------------------------------------------------------------ autoplay
    const DWELL = 2000;
    let timer: number | undefined;
    let held = false; // the visitor pressed pause
    let hover = false; // pointer or focus is inside the deck

    const running = () => !held && !hover && onScreen && !document.hidden && !calm.matches;

    function restart() {
      window.clearTimeout(timer);
      root.classList.toggle("is-auto", running());
      root.classList.toggle("is-held", !running());
      if (!running()) return;
      timer = window.setTimeout(() => {
        active = (active + 1) % n;
        render();
        restart();
      }, DWELL);
    }

    const hold = root.querySelector<HTMLButtonElement>("[data-hold]");
    const holdLabel = root.querySelector<HTMLElement>("[data-holdlabel]");
    if (hold && !calm.matches) {
      hold.hidden = false;
      hold.addEventListener("click", () => {
        held = !held;
        root.classList.toggle("is-hold", held);
        if (holdLabel) holdLabel.textContent = held ? "Play" : "Pause";
        restart();
      });
    }

    const enter = () => {
      hover = true;
      restart();
    };
    const leave = () => {
      hover = false;
      restart();
    };

    // :hover is no use here for the same reason the links were unclickable —
    // the browser's hit region for a 3D-transformed pane is not where it
    // paints, so a pane behind the front one never matched :hover, never
    // showed a pointer cursor, and never paused the rack. The cursor is
    // reaching for a card that keeps moving, which is what made it feel
    // clunky. So the hot pane is worked out from the same boxes the click
    // uses, and hover, cursor and pause all follow from that one answer.
    let hot: HTMLElement | null = null;

    function setHot(p: HTMLElement | null) {
      if (p === hot) return;
      hot?.classList.remove("is-hot");
      p?.classList.add("is-hot");
      hot = p;
      stage.classList.toggle("is-over", !!p);
      if (!!p !== hover) {
        hover = !!p;
        restart();
      }
    }

    if (window.matchMedia("(hover: hover)").matches) {
      stage.addEventListener("pointermove", (e) => {
        setHot(paneAt(e.clientX, e.clientY));
      });
      stage.addEventListener("pointerleave", () => setHot(null));
    }

    root.addEventListener("focusin", enter);
    root.addEventListener("focusout", (e) => {
      if (!root.contains(e.relatedTarget as Node | null)) leave();
    });
    document.addEventListener("visibilitychange", () => restart());

    // A pane in the rack is a 3D-transformed element, and the browser's hit
    // region for one does not line up with where it paints: elementFromPoint
    // over a visible back pane returns the stage, so its link is unreachable
    // by mouse however visible it looks. Rather than fight that, the stage
    // routes the click itself, front pane first, using the boxes the panes
    // actually occupy on screen. The anchors stay for keyboard, middle-click
    // and the status bar.
    /** The pane a point lands on: front-most first, parked ones skipped. */
    function paneAt(x: number, y: number): HTMLElement | null {
      const byDepth = [...panes].sort(
        (a, b) => Number(a.dataset.rel) - Number(b.dataset.rel),
      );
      for (const p of byDepth) {
        if (Number(p.dataset.rel) > 3) continue;
        const r = p.getBoundingClientRect();
        if (x >= r.left && x <= r.right && y >= r.top && y <= r.bottom) return p;
      }
      return null;
    }

    stage.addEventListener("click", (e) => {
      if ((e.target as Element).closest(".pane__hit")) return; // browser got it
      const p = paneAt(e.clientX, e.clientY);
      if (p) go(p);
    });

    /** Hand the pane's own image to the next page, then navigate. */
    function go(p: HTMLElement) {
      const img = p.querySelector<HTMLElement>(".pane__shot");
      if (img) img.style.viewTransitionName = "work-hero";
      window.location.href = p.dataset.href!;
    }

    // The panes are links straight to their projects, so the rail is what
    // selects. Choosing by hand restarts the dwell rather than ending it.
    deck.querySelectorAll<HTMLButtonElement>("[data-select]").forEach((el) => {
      el.addEventListener("click", () => select(Number(el.dataset.select)));
    });

    deck.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight") select(active + 1);
      else if (e.key === "ArrowLeft") select(active - 1);
      else return;
      e.preventDefault();
      dots[active]!.focus();
    });

    // Pointer parallax. One rAF in flight at a time, and nothing under calm.
    if (!calm.matches && window.matchMedia("(pointer: fine)").matches) {
      let queued = false;
      let px = 0;
      let py = 0;

      deck.addEventListener("pointermove", (e) => {
        const r = stage.getBoundingClientRect();
        px = ((e.clientX - r.left) / r.width) * 2 - 1;
        py = ((e.clientY - r.top) / r.height) * 2 - 1;
        if (queued) return;
        queued = true;
        requestAnimationFrame(() => {
          stage.style.setProperty("--px", px.toFixed(3));
          stage.style.setProperty("--py", py.toFixed(3));
          queued = false;
        });
      });

      deck.addEventListener("pointerleave", () => {
        stage.style.setProperty("--px", "0");
        stage.style.setProperty("--py", "0");
      });
    }

    new IntersectionObserver(
      (entries) => {
        onScreen = entries[0]!.isIntersecting;
        playFront();
        restart();
      },
      { threshold: 0.25 },
    ).observe(deck);

    calm.addEventListener("change", () => {
      playFront();
      if (hold) hold.hidden = calm.matches;
      restart();
    });

    render();
    restart();
  }
</script>
