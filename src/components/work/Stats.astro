---
interface Item {
  value: string;
  label: string;
  note?: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<dl class="stats">
  {
    items.map((s) => (
      <div class="stats__item">
        <dt class="stats__value data">{s.value}</dt>
        <dd class="stats__label">
          {s.label}
          {s.note && <span class="stats__note note">{s.note}</span>}
        </dd>
      </div>
    ))
  }
</dl>

<style>
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 1.5rem 2rem;
    margin: 2.25rem 0;
    padding-block: 1.5rem;
    border-block: 1px solid var(--line);
  }

  .stats__item {
    display: grid;
    gap: 0.3rem;
  }

  .stats__value {
    font-size: var(--step-3);
    color: var(--accent-ink);
    line-height: 1;
  }

  .stats__label {
    margin: 0;
    font-size: var(--step--1);
    color: var(--ink);
  }

  .stats__note {
    display: block;
    margin-top: 0.15rem;
  }
</style>
