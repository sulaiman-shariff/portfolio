---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  /** "wide" breaks out of the prose column; "full" goes edge to edge. */
  width?: "prose" | "wide";
}

const { src, alt, caption, width = "wide" } = Astro.props;
---

<figure class:list={["fig", `fig--${width}`]}>
  <div class="fig__frame">
    <Image
      src={src}
      alt={alt}
      widths={[720, 1080, 1440]}
      sizes="(min-width: 64rem) 60rem, 100vw"
      loading="lazy"
      decoding="async"
    />
  </div>
  {caption && <figcaption class="note">{caption}</figcaption>}
</figure>

<style>
  .fig {
    margin: 2.5rem 0;
  }

  .fig--prose {
    max-width: var(--measure);
  }

  /* Screenshots are wider than the reading column; let them breathe without
     going full-bleed, which would lose the page's left edge. */
  @media (min-width: 72rem) {
    .fig--wide {
      width: min(64rem, 100vw - 2 * var(--gutter));
    }
  }

  .fig__frame {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--surface-2);
    display: grid;
    place-items: center;
  }

  .fig__frame :global(img) {
    max-width: 100%;
    height: auto;
  }

  .fig figcaption {
    margin-top: 0.7rem;
    max-width: 60ch;
  }
</style>
